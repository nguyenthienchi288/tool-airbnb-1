# ==============================================================================
# AIRBNB MARKET CLI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Browser settings
HEADLESS=true
SLOW_MO=50
PAGE_TIMEOUT_MS=45000

# Natural delay range between requests (milliseconds) to avoid rate-limiting
MIN_DELAY_MS=1800
MAX_DELAY_MS=4200

# Optional HTTP/SOCKS5 Proxy (leave empty if not used)
# Example: http://user:pass@proxy-host:8080
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Reverse Geocoding Provider: "nominatim" (free, OpenStreetMap) or "google"
GEOCODER_PROVIDER=nominatim
# Required only if GEOCODER_PROVIDER=google
GOOGLE_PLACES_API_KEY=
# Custom User-Agent for Nominatim (required by OSM usage policy)
NOMINATIM_USER_AGENT=AirbnbMarketResearchCLI/1.0 (contact@example.com)

# Storage & Output paths
DB_PATH=./data/airbnb_market.db
OUTPUT_DIR=./output
